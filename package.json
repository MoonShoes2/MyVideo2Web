{
  "name": "zhuiying-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "追影 · 在线影视播放器 Web 版（Android 端的功能与视觉迁移）",
  "scripts": {
    "dev": "concurrently -k -n proxy,web -c yellow,cyan \"node server/index.mjs\" \"vite\"",
    "dev:web": "vite",
    "dev:proxy": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "hls.js": "^1.5.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "express": "^4.21.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
